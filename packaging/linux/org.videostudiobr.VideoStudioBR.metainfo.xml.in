<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.videostudiobr.VideoStudioBR</id>
  <launchable type="desktop-id">org.videostudiobr.VideoStudioBR.desktop</launchable>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <name>Vídeo Studio BR</name>
  <summary>Editor de vídeo livre, em português, com interface moderna</summary>
  <description>
    <p>
      Vídeo Studio BR é um editor de vídeo livre, de código aberto e multiplataforma,
      derivado do Shotcut. Mantém paridade funcional com o projeto original e traz
      uma casca QML moderna em azul/noite, com interface em português do Brasil.
    </p>
    <p>
      Oferece edição não linear em múltiplas trilhas, amplo suporte a formatos via
      FFmpeg/MLT, filtros de áudio e vídeo, captura de tela e câmera, além de
      monitoramento externo e exportação configurável.
    </p>
  </description>
  <developer_name>Vídeo Studio BR (baseado em Shotcut, Meltytech LLC)</developer_name>
  <url type="homepage">https://github.com/ronney13/studiocut</url>
  <url type="bugtracker">https://github.com/ronney13/studiocut/issues</url>
  <url type="vcs-browser">https://github.com/ronney13/studiocut</url>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@SHOTCUT_VERSION@" date="@SHOTCUT_DATE@"/>
  </releases>
</component>

{
  "app-id": "org.videostudiobr.VideoStudioBR",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.8",
  "sdk": "org.kde.Sdk",
  "command": "video-studio-br",
  "finish-args": [
    "--share=ipc",
    "--socket=x11",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--device=dri",
    "--share=network",
    "--filesystem=home",
    "--filesystem=xdg-videos",
    "--filesystem=xdg-download"
  ],
  "environment": {
    "LD_LIBRARY_PATH": "/app/video-studio-br/lib"
  },
  "cleanup": ["/include", "/lib/pkgconfig", "/share/man", "/share/doc"],
  "modules": [
    {
      "name": "video-studio-br",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/video-studio-br",
        "cp -a ./linux-app/usr/. /app/video-studio-br/",
        "install -Dm755 /app/video-studio-br/bin/video-studio-br /app/bin/video-studio-br",
        "install -Dm644 /app/video-studio-br/share/applications/org.videostudiobr.VideoStudioBR.desktop /app/share/applications/org.videostudiobr.VideoStudioBR.desktop",
        "install -Dm644 /app/video-studio-br/share/metainfo/org.videostudiobr.VideoStudioBR.metainfo.xml /app/share/metainfo/org.videostudiobr.VideoStudioBR.metainfo.xml",
        "install -Dm644 /app/video-studio-br/share/icons/hicolor/scalable/apps/org.videostudiobr.VideoStudioBR.svg /app/share/icons/hicolor/scalable/apps/org.videostudiobr.VideoStudioBR.svg",
        "for size in 16 24 32 48 64 128 256; do install -Dm644 /app/video-studio-br/share/icons/hicolor/${size}x${size}/apps/org.videostudiobr.VideoStudioBR.png /app/share/icons/hicolor/${size}x${size}/apps/org.videostudiobr.VideoStudioBR.png; done"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "src"
        }
      ]
    }
  ]
}
